# .env.example — copy to .env and fill in real values before running docker compose.
# NEVER commit .env to version control (.gitignore already excludes it).

# ── Required ──────────────────────────────────────────────────────────────────
# Postgres password (min 16 chars recommended)
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password

# Gateway JWT signing secret (min 32 chars; generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32_chars

# ── Optional — Postgres (defaults shown) ──────────────────────────────────────
# POSTGRES_USER=railway
# POSTGRES_DB=railway

# ── Optional — Redis ──────────────────────────────────────────────────────────
# Internal service URL used by gateway and scheduler.
# Default (used when unset): redis://redis:6379/0
# REDIS_URL=redis://redis:6379/0

# ── Optional — BDMS live endpoint ─────────────────────────────────────────────
# Leave commented for simulation mode (safe for dev/staging).
# BDMS_URL=https://bdms.railnet.gov.in/api/v1

# ── Optional — live source endpoints for TMS/SMMS/TDMS/COA ───────────────────
# Leave commented to use CSV fixtures (deterministic, offline-safe).
# BANDHAN_TMS_URL=https://tms.zonal.railnet.gov.in/api/defects
# BANDHAN_SMMS_URL=https://smms.zonal.railnet.gov.in/api/defects
# BANDHAN_TDMS_URL=https://tdms.zonal.railnet.gov.in/api/defects
# BANDHAN_CORRIDOR_URL=https://bdms.railnet.gov.in/api/sections
# BANDHAN_COA_TIMETABLE_URL=https://coa.railnet.gov.in/api/timetable

# ── Optional — HMAC secrets for live source signature verification ─────────────
# BANDHAN_TMS_HMAC_SECRET=...
# BANDHAN_SMMS_HMAC_SECRET=...
# BANDHAN_TDMS_HMAC_SECRET=...

# ── Optional — Gateway tuning ─────────────────────────────────────────────────
# Minimum free disk space before /health returns 503 (GB)
# DISK_WARN_GB=1

# Reconciliation job interval (seconds) — how often to scan stale pending records
# RECONCILE_INTERVAL_S=120

# ── Emergency / recovery ──────────────────────────────────────────────────────
# Set to 1 ONLY when you explicitly want to discard a corrupt state.json.
# Losing audit/publication history is irreversible — require operator intent.
# BANDHAN_RESET_CORRUPT_STATE=0
