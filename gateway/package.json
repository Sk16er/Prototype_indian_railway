{
  "name": "bandhan-gateway",
  "version": "1.0.0",
  "description": "BANDHAN Railway Gateway — Node/Express API proxy with transactional outbox",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "jest": {
    "testMatch": ["**/tests/**/*.test.mjs"],
    "transform": {}
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
